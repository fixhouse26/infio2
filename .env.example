# REQUIRED FOR DIRECT WEBSITE EMAIL DELIVERY VIA RESEND
# Create an API key in Resend and verify the infio2.com domain.
RESEND_API_KEY=re_xxxxxxxxx

# Every website trip inquiry is delivered here:
TRAVEL_LEAD_EMAIL=info@infio2.com

# Sender must use your verified Resend domain.
# You may change noreply to info after confirming that sender in your Resend setup.
TRAVEL_FROM_EMAIL=InfiO2 Travel <noreply@infio2.com>

# Optional analytics
NEXT_PUBLIC_GA_ID=
