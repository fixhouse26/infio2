# REQUIRED FOR DIRECT WEBSITE EMAIL DELIVERY VIA RESEND
# Create an API key in Resend and verify the infio2.com domain.
RESEND_API_KEY=re_xxxxxxxxx

# Every website trip inquiry is delivered here:
TRAVEL_LEAD_EMAIL=info@infio2.com

# Sender must use your verified Resend domain.
# You may change noreply to info after confirming that sender in your Resend setup.
TRAVEL_FROM_EMAIL=InfiO2 Travel <noreply@infio2.com>

# Optional analytics
NEXT_PUBLIC_GA_ID=


# OPTIONAL OPENAI PERSONALIZATION
# Leave blank and the site still generates preliminary plans from the InfiO2 travel library at $0 AI usage.
OPENAI_API_KEY=
OPENAI_ITINERARY_MODEL=gpt-5.6-luna

# hybrid = use library first and AI only for more customized requests
# library = never call OpenAI
# always = personalize every uncached itinerary with OpenAI
AI_ITINERARY_MODE=hybrid

# OPTIONAL PERSISTENT ITINERARY CACHE
# If you connect a Redis/Upstash-compatible REST store, repeated matching trips can reuse saved itineraries.
# Without these variables the app uses an in-memory warm-instance cache plus the built-in travel library.
KV_REST_API_URL=
KV_REST_API_TOKEN=
